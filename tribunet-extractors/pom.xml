<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>ekonomi</artifactId>
        <groupId>name.julatec.ekonomi</groupId>
        <version>1.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>name.julatec.ekonomi</groupId>
    <artifactId>tribunet-extractors</artifactId>
    <name>tribunet-extractors</name>
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>cr/go/hacienda/**</exclude>
                        <exclude>name/julatec/ekonomi/tribunet/annotation/**</exclude>
                        <exclude>name/julatec/ekonomi/tribunet/*Factory.class</exclude>
                        <exclude>name/julatec/ekonomi/tribunet/*Factory$*.class</exclude>
                        <!-- IMAP infrastructure commands - require real mail server -->
                        <exclude>name/julatec/ekonomi/extract/command/SessionCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/StoreCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/FolderCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/InboxCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/MessageCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/XmlAttachmentCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/ZipAttachmentCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/DocumentoCommandFactory.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/CommandFactory.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/BaseCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/DocumentCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/FacturaCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/FacturaCompraCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/FacturaExportacionCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/NotaCreditoCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/NotaDebitoCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/MensajeHaciendaCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/MensajeReceptorCommand.class</exclude>
                        <exclude>name/julatec/ekonomi/extract/command/StoreCommand.class</exclude>
                        <!-- Service - requires Spring context with repositories -->
                        <exclude>name/julatec/ekonomi/extract/ExtractService.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>name.julatec.ekonomi</groupId>
            <artifactId>tribunet-adapters</artifactId>
            <version>${name.julatec.ekonomi.version}</version>
        </dependency>
        <dependency>
            <groupId>name.julatec.ekonomi</groupId>
            <artifactId>storage</artifactId>
            <version>${name.julatec.ekonomi.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>1.6.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
        </dependency>
    </dependencies>
</project>
