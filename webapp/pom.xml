<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>ekonomi</artifactId>
    <groupId>name.julatec.ekonomi</groupId>
    <version>1.0.2-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <groupId>name.julatec.ekonomi</groupId>
  <artifactId>webapp</artifactId>
  <packaging>war</packaging>
  <name>ekonomi</name>
  <description>Ekonomi - Finance Statistics Services</description>
  <dependencies>
    <!--
      El contenedor de servlets lo pone Tomcat, no el WAR.

      `spring-boot-starter-tomcat` llega transitivamente por el starter web, en alcance
      `compile`, y arrastraba tomcat-embed-core, tomcat-embed-el y tomcat-annotations-api
      dentro del WEB-INF/lib: 3,8 MB de Tomcat 10.1.39 empaquetados en una aplicación que
      se despliega sobre un Tomcat 11.0.6 propio. Nunca se ejecutaban —el contenedor gana
      siempre— pero convivían dos versiones de las mismas clases, que es la clase de cosa
      que produce fallos incomprensibles después de una actualización.

      Declararlo acá en `provided` gana por cercanía sobre la transitiva y lo saca del
      empaquetado. Ya existía la exclusión de tomcat-embed-websocket más abajo, así que el
      problema se conocía a medias.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>name.julatec.ekonomi</groupId>
      <artifactId>storage</artifactId>
      <version>${name.julatec.ekonomi.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>name.julatec.ekonomi</groupId>
      <artifactId>tribunet-extractors</artifactId>
      <version>${name.julatec.ekonomi.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.apache.tomcat.embed</groupId>
          <artifactId>tomcat-embed-websocket</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.social</groupId>
      <artifactId>spring-social-facebook</artifactId>
      <version>2.0.3.RELEASE</version>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.1.0</version>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>1.9.1</version>
          <configuration>
            <installDirectory>target</installDirectory>
          </configuration>
          <executions>
            <execution>
              <id>install node and npm</id>
              <goals>
                <goal>install-node-and-npm</goal>
              </goals>
              <configuration>
                <nodeVersion>v10.11.0</nodeVersion>
                <npmVersion>6.4.1</npmVersion>
              </configuration>
            </execution>
            <execution>
              <id>npm install</id>
              <goals>
                <goal>npm</goal>
              </goals>
              <configuration>
                <arguments>install</arguments>
              </configuration>
            </execution>
            <execution>
              <id>webpack build</id>
              <goals>
                <goal>webpack</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
