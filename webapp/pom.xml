<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>ekonomi</artifactId>
    <groupId>name.julatec.ekonomi</groupId>
    <version>1.0.2-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <groupId>name.julatec.ekonomi</groupId>
  <artifactId>webapp</artifactId>
  <packaging>war</packaging>
  <name>ekonomi</name>
  <description>Ekonomi - Finance Statistics Services</description>
  <dependencies>
    <!--
      El contenedor de servlets lo pone Tomcat, no el WAR.

      `spring-boot-starter-tomcat` llega transitivamente por el starter web, en alcance
      `compile`, y arrastraba tomcat-embed-core, tomcat-embed-el y tomcat-annotations-api
      dentro del WEB-INF/lib: 3,8 MB de Tomcat 10.1.39 empaquetados en una aplicación que
      se despliega sobre un Tomcat 11.0.6 propio. Nunca se ejecutaban —el contenedor gana
      siempre— pero convivían dos versiones de las mismas clases, que es la clase de cosa
      que produce fallos incomprensibles después de una actualización.

      Declararlo acá en `provided` gana por cercanía sobre la transitiva y lo saca del
      empaquetado. Ya existía la exclusión de tomcat-embed-websocket más abajo, así que el
      problema se conocía a medias.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>name.julatec.ekonomi</groupId>
      <artifactId>mcp-server</artifactId>
      <version>${name.julatec.ekonomi.version}</version>
      <scope>compile</scope>
    </dependency>
    <!--
      El transporte MCP. Va acá y no en `mcp-server` a propósito: este starter
      arrastra spring-boot-starter-web —y con él un Tomcat embebido— y el WAR se
      despliega sobre un Tomcat propio. La declaración `provided` de arriba gana
      por ser directa y lo mantiene fuera de WEB-INF/lib.
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
      <version>${spring-ai.version}</version>
    </dependency>
    <dependency>
      <groupId>name.julatec.ekonomi</groupId>
      <artifactId>storage</artifactId>
      <version>${name.julatec.ekonomi.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>name.julatec.ekonomi</groupId>
      <artifactId>tribunet-extractors</artifactId>
      <version>${name.julatec.ekonomi.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.1.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Borra la salida anterior del frontend de `target/classes` antes de que se copie la
        nueva.

        `emptyOutDir` de Vite vacía `src/main/resources/static/dist`, pero la copia de recursos
        de Maven es incremental: no borra lo que ya no existe en el origen. Y como cada build
        le pone a los archivos un nombre distinto —el hash del contenido—, lo viejo se
        acumulaba: un `mvn package` sin `clean` metía en el WAR tres copias de Mermaid y cuatro
        del bundle principal, dos megas de código muerto que ningún `index.html` referencia.
        Nada se rompía, y esa es justamente la razón para arreglarlo: el artefacto dejaba de
        corresponder al fuente sin que nada lo dijera.

        Va en `generate-resources`, antes de que Vite escriba y antes de que Maven copie.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>limpiar la salida anterior del frontend</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${project.build.outputDirectory}/static/dist</directory>
                </fileset>
                <!-- Y la misma carpeta en el WAR explotado, que el maven-war-plugin también
                     arma de forma incremental: sin esto `target/classes` queda limpio y el
                     WAR igual sale con lo viejo adentro. -->
                <fileset>
                  <directory>${project.build.directory}/${project.build.finalName}/WEB-INF/classes/static/dist</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        El bundle del frontend se construye acá y no a mano.

        Antes esto vivía en <pluginManagement>, que declara la configuración pero no ejecuta
        nada: `mvn package` no reconstruía la interfaz y el bundle estaba commiteado. Cualquier
        cambio en el código de la interfaz que alguien olvidara compilar a mano se perdía en
        silencio, y el artefacto no correspondía al fuente.

        Node se instala dentro de `target/` y no se toma del PATH: el build tiene que dar el
        mismo resultado en la máquina de quien programa y en la que arma el release.
      -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.1</version>
        <configuration>
          <installDirectory>${project.build.directory}</installDirectory>
          <workingDirectory>frontend</workingDirectory>
        </configuration>
        <executions>
          <execution>
            <id>instalar node y npm</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <configuration>
              <nodeVersion>v22.11.0</nodeVersion>
            </configuration>
          </execution>
          <execution>
            <id>npm ci</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <!-- `ci` y no `install`: instala exactamente el package-lock.json y falla si
                   no coincide, en vez de resolver versiones nuevas en cada build. -->
              <arguments>ci</arguments>
            </configuration>
          </execution>
          <execution>
            <id>vite build</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
