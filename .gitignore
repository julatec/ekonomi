*.iml
.idea
*/target

# Frontend: nada de lo que produce el build se versiona.
#
# El package-lock.json SÍ va —es lo que hace reproducible el `npm ci` del build de Maven—;
# lo que no va es el bundle. Antes `static/built/bundle.js` estaba commiteado a mano y el
# artefacto podía no corresponder al fuente.
webapp/frontend/node_modules/
webapp/src/main/resources/static/dist/

# Docker
.env
docker-compose.override.yml
backups/
*.sql
# Los del contenedor sí van: crean los esquemas y siembran el usuario del ambiente local.
!docker/mysql/init/*.sql
!docker/mysql/seed-local.sql

# Material criptográfico del ambiente local: se regenera con `make dev-certs`.
# No se versiona ninguna llave, ni siquiera de un autofirmado desechable.
docker/certs/*.pem
docker/certs/*.p12
docker/certs/*.srl

# Python — entornos virtuales
.venv/
**/.venv/
__pycache__/
*.pyc
