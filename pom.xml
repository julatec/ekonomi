<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>name.julatec.ekonomi</groupId>
    <artifactId>ekonomi</artifactId>
    <version>1.0.2-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ekonomi</name>
    <url>https://github.com/julatec/ekonomi</url>
    <inceptionYear>2020</inceptionYear>

    <!--
      La licencia estaba en LICENSE.txt desde 2020 y en ningun otro lado: ni el POM la
      declaraba, ni el README la mencionaba, ni los artefactos la llevaban. Un WAR sin
      metadatos de licencia obliga a abrir el jar y leer el archivo para saber bajo que
      terminos se recibio, que es justo lo que estos bloques evitan.

      Cubre el CODIGO. La contabilidad que el codigo procesa (facturas electronicas,
      cedulas, montos) no es parte de la obra licenciada: vive en la base de cada tenant
      y no se distribuye con el fuente. Ver la seccion "Licencia" del README.

      (Sin guiones dobles adentro: un comentario XML no los admite.)
    -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>José de Jesús Ulate Cárdenas</name>
            <email>me@julatec.name</email>
            <url>https://julatec.name</url>
            <roles>
                <role>Diseño, implementación y operación</role>
            </roles>
            <timezone>America/Costa_Rica</timezone>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/julatec/ekonomi</url>
        <connection>scm:git:https://github.com/julatec/ekonomi.git</connection>
        <developerConnection>scm:git:git@github.com:julatec/ekonomi.git</developerConnection>
    </scm>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <name.julatec.ekonomi.version>1.0.2-SNAPSHOT</name.julatec.ekonomi.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>name.julatec.utils</groupId>
            <artifactId>utils</artifactId>
            <version>1.0.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>name.julatec.ekonomi</groupId>
            <artifactId>tribunet</artifactId>
            <!-- 1.1.6 arregla el generador de adaptadores: un nodo opcional ausente en el XML
                 —el Receptor de un tiquete, que en el esquema de Hacienda es minOccurs="0"—
                 hacía que el constructor generado lanzara NullPointerException y el comprobante
                 se perdiera en silencio. 120 documentos el 5 sep 2026 en producción.

                 1.1.7 sube cxf-core (4.1.1 -> 4.1.8) por GHSA-ghvc-7hp8-2g2v / CVE-2026-50645
                 (sin restricción en encabezados de adjunto por mensaje). Es scope compile sin
                 override acá, así que la versión vulnerable quedaba de verdad en WEB-INF/lib
                 del WAR desplegado (confirmado con `mvn dependency:tree` antes de subirla). -->
            <version>1.1.7</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <modules>
        <module>tribunet-adapters</module>
        <module>tribunet-extractors</module>
        <module>storage</module>
        <module>mcp-server</module>
        <module>webapp</module>
    </modules>

<build>
    <plugins>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.16.0</version>
            <configuration>
                <annotationProcessors>
                    <annotationProcessor>
                        name.julatec.ekonomi.tribunet.annotation.AdapterProcessor
                    </annotationProcessor>
                </annotationProcessors>
            </configuration>
        </plugin>
    </plugins>
</build>
</project>
